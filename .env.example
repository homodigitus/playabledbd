# --- Runtime ---
NODE_ENV=development

# --- Ports / URLs ---
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000
# Browser-visible API base URL used by apps/web (must match a CORS_ORIGINS-allowed relationship)
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Database ---
# Local (pnpm dev, DB reachable on localhost via docker-compose port mapping)
DATABASE_URL=postgresql://lumen:lumen@localhost:5432/lumen_rag
# In docker-compose network, api/mcp use: postgresql://lumen:lumen@db:5432/lumen_rag

# --- Sessions / auth ---
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# --- AI provider (OpenAI-compatible) ---
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4.1-mini

# --- Ingestion / chunking ---
# Relative to apps/api's working directory (pnpm --filter runs package scripts from that
# package's own directory, not the repo root) — resolves to <repo root>/corpus for local dev.
# docker-compose overrides this to the absolute in-container path /app/corpus.
CORPUS_ROOT=../../corpus
CHUNK_SIZE_TOKENS=800
CHUNK_OVERLAP_TOKENS=120

# --- Retrieval ---
RETRIEVAL_MODE=hybrid
RETRIEVAL_TOP_K=5
RETRIEVAL_MIN_SCORE=0.15

# --- MCP ---
MCP_TRANSPORT=stdio
MCP_PORT=4100
MCP_AUTH_TOKEN=replace-for-http-transport

# --- Demo users (local/demo only, never use in production) ---
DEMO_ADMIN_EMAIL=admin@example.com
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_USER_EMAIL=user@example.com
DEMO_USER_PASSWORD=ChangeMe123!
